{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jspillers10/mcp-security-scanner/benchmark/schemas/manifest.schema.json",
  "title": "MCP scanner benchmark manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpora"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "corpora": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/corpus"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "status", "source", "license_file_present", "note"],
      "properties": {
        "declared": {"type": "string"},
        "status": {"enum": ["verified", "declared-unverified", "project-owned"]},
        "source": {"type": "string"},
        "license_file_present": {"type": "boolean"},
        "note": {"type": "string"}
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern", "reason"],
      "properties": {
        "pattern": {"type": "string"},
        "reason": {"type": "string"}
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "repository", "commit", "retrieved_at", "license", "language", "mcp_framework",
        "intentionally_vulnerable", "execution_prohibited", "compatibility_notes", "default_path",
        "ground_truth", "scope_note", "require_git_commit", "tree_sha256", "files", "excluded"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "name": {"type": "string", "minLength": 1},
        "repository": {"type": ["string", "null"]},
        "commit": {"type": ["string", "null"]},
        "retrieved_at": {"type": "string", "format": "date"},
        "license": {"$ref": "#/$defs/license"},
        "language": {"const": "python"},
        "mcp_framework": {"type": "string", "minLength": 1},
        "intentionally_vulnerable": {"enum": [true, false, "mixed"]},
        "execution_prohibited": {"type": "boolean"},
        "compatibility_notes": {"type": "string", "minLength": 1},
        "default_path": {"type": "string", "minLength": 1},
        "ground_truth": {"type": "string", "minLength": 1},
        "scope_note": {"type": "string", "minLength": 1},
        "require_git_commit": {"type": "boolean"},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
        "excluded": {"type": "array", "items": {"$ref": "#/$defs/exclusion"}}
      }
    }
  }
}
